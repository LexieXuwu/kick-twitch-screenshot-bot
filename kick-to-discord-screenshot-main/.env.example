# Kick channel to watch (required)
KICK_CHANNEL=your_kick_username

# Discord webhook URL (required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Twitch (optional) - add both to enable Twitch chat alongside Kick
# Get OAuth token from https://twitchapps.com/tmi
# TWITCH_CHANNEL=your_twitch_username
# TWITCH_OAUTH_TOKEN=oauth:your_token

# Optional: separate webhooks for pics, gifs, clips (fall back to main if not set)
# DISCORD_WEBHOOK_PICS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_GIFS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_CLIPS=https://discord.com/api/webhooks/...
